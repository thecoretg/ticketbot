# Ticketbot app environment. Copy to .env at the repo root (or mount it there with 1Password
# Environments), then `make db-up` and `make run`. All variables are read once at startup by
# internal/env; a missing required value or a malformed number aborts startup.

# ── Database ─────────────────────────────────────────────────────────────────
# `make db-up` starts Postgres on localhost:5433 with testuser/testpass/testdb by default.
POSTGRES_DSN=host=localhost port=5433 dbname=testdb user=testuser password=testpass sslmode=disable
# Max open connections in the pgx pool (default 10).
# POSTGRES_MAX_CONNS=10
# Override the container defaults if needed (also used by `make docker-up`):
# DB_USER=testuser
# DB_PASSWORD=testpass
# DB_NAME=testdb
# DB_PORT=5433

# ── App ──────────────────────────────────────────────────────────────────────
PORT=8080
INITIAL_ADMIN_EMAIL=admin@example.com
# Only used when the admin user does not exist yet.
INITIAL_ADMIN_PASSWORD=changeme
# Public URL ConnectWise can reach for webhooks. Required unless SKIP_HOOKS=true.
# ROOT_URL=https://your-domain.com

# ── ConnectWise ──────────────────────────────────────────────────────────────
CW_PUB_KEY=
CW_PRIV_KEY=
CW_CLIENT_ID=
CW_COMPANY_ID=

# ── Webex ────────────────────────────────────────────────────────────────────
WEBEX_SECRET=

# ── Local testing ────────────────────────────────────────────────────────────
SKIP_HOOKS=true     # don't register a ConnectWise callback
MOCK_WEBEX=true     # log Webex messages instead of sending
DEBUG=false         # debug logging and gin debug mode from boot (log level also toggleable in Config)
# STORE_TTL_SECONDS=900   # how long cached ConnectWise lookups stay fresh (default 900)
